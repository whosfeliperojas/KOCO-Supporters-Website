# Copy this file to .env.local and fill in real values — never commit .env.local.

# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash Redis (upstash.com free tier) — enables durable API rate limiting.
# Without these, rate limiting is skipped (fails open); everything else still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed if you run scripts/bootstrap-admins.mjs
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_NAME=
BOOTSTRAP_ADMIN_2_EMAIL=
BOOTSTRAP_ADMIN_2_NAME=
BOOTSTRAP_ADMIN_3_EMAIL=
BOOTSTRAP_ADMIN_3_NAME=
BOOTSTRAP_ADMIN_3_PROFILE_ID=
BOOTSTRAP_VOLUNTEER_EMAIL=
BOOTSTRAP_VOLUNTEER_PROFILE_ID=
